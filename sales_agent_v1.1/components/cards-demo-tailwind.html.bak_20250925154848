  <!-- Battery expansion demo calculations (kept local to this component page) -->
  <script>
    (function(){
      const battery_dod = 0.9;            // 放电深度
      const battery_rte = 0.92;           // 循环效率
      const annual_effective_days = 300;  // 年有效天数
      const grid_buy_rate_aud = 0.30;     // 购电价 (AUD/kWh)
      const grid_sell_rate_aud = 0.08;    // 售电价 (AUD/kWh)
      const fluctuation = 0.12;           // 展示浮动比例 ±12%

      // 成本估算（演示用）
      const install_base_fee = 1200;      // 基础费 AUD
      const cost_per_kwh = 800;           // 每kWh电池成本 AUD
      const power_install_per_kw = 150;   // 每kW安装费（近似按标称容量） AUD
      const profit_rate = 0.25;           // 扩容利润率（演示）
      const budget_range_fluct = 0.10;    // 报价浮动展示（±10% 演示）

      // 自用率相关预设
      const existing_sc_rate = 0.30;                // 预设已有自用率 30%
      const existing_solar_annual_gen_kwh = 7000;   // 预设已有光伏年发电量（示例）
      const theoretical_usage_ratio = 0.70;         // 屋顶理论使用系数 70%

      function calc(capacityKwh){
        const daily_effective_discharge = capacityKwh * battery_dod * battery_rte; // kWh/day
        const annual_saving = daily_effective_discharge * (grid_buy_rate_aud - grid_sell_rate_aud) * annual_effective_days;
        const saving_low = annual_saving * (1 - fluctuation);
        const saving_high = annual_saving * (1 + fluctuation);

        const system_cost = capacityKwh * cost_per_kwh + install_base_fee + capacityKwh * power_install_per_kw;
        const quote_base = system_cost * (1 + profit_rate); // 报价基准
        const budget_low = quote_base * (1 - budget_range_fluct);
        const budget_high = quote_base * (1 + budget_range_fluct);
        const payback_low = system_cost / Math.max(saving_high, 1e-6); // 下限：更快
        const payback_high = system_cost / Math.max(saving_low, 1e-6);  // 上限：更慢

        const added_selfuse_kwh = capacityKwh * battery_dod * battery_rte * annual_effective_days;
        const selfuse_increase = added_selfuse_kwh / (existing_solar_annual_gen_kwh * theoretical_usage_ratio);
        const after_selfuse = existing_sc_rate + selfuse_increase;
        const selfuse_low = Math.max(after_selfuse * (1 - fluctuation), 0);
        const selfuse_high = Math.min(after_selfuse * (1 + fluctuation), 0.98);

        return { saving_low, saving_high, payback_low, payback_high, selfuse_low, selfuse_high, budget_low, budget_high };
      }

      function fmtCurrency(v){ return `$${v.toFixed(0)}`; }
      function fmtRangeCurrency(a,b){ return `${fmtCurrency(a)} – ${fmtCurrency(b)}`; }
      function fmtYears(v){ return `${v.toFixed(2)} years`; }
      function fmtRangeYears(a,b){ return `${fmtYears(a)} – ${fmtYears(b)}`; }
      function fmtPct(v){ return `${Math.round(v*100)}%`; }
      function fmtRangePct(a,b){ return `${fmtPct(a)} – ${fmtPct(b)}`; }

      const els = {
        capacity: document.getElementById('batteryCapacityLabel'),
        saving: document.getElementById('bAnnualSavingRange'),
        payback: document.getElementById('bPaybackRange'),
        selfuse: document.getElementById('bSelfUseRange'),
        tag: document.getElementById('bPlanTag'),
        budget: document.getElementById('bBudgetRange'),
        size: document.getElementById('bSizeText')
      };

      function applyPlan(planKey, capacity){
        const r = calc(capacity);
        if (!els.payback) return;
        if (els.capacity) els.capacity.textContent = `Capacity ${capacity} kWh`;
        if (els.budget) els.budget.textContent = `${fmtCurrency(r.budget_low)} – ${fmtCurrency(r.budget_high)}`;
        if (els.size) els.size.textContent = `${capacity} kWh`;
        els.saving.textContent = fmtRangeCurrency(r.saving_low, r.saving_high);
        els.payback.textContent = fmtRangeYears(r.payback_low, r.payback_high);
        els.selfuse.textContent = fmtRangePct(r.selfuse_low, r.selfuse_high);
        if (els.tag) els.tag.textContent = `Plan ${planKey}`;
      }

      function bindBatteryCards(){
        document.querySelectorAll('.battery-scheme-mini').forEach(btn => {
          if (btn.__bound) return; btn.__bound = true;
          btn.addEventListener('click', () => {
            const key = btn.getAttribute('data-scheme') || '';
            const capacity = parseFloat(btn.getAttribute('data-capacity') || '0');
            applyPlan(key, capacity);
          });
        });
      }

      function init(){
        bindBatteryCards();
        // 默认显示方案A
        const first = document.querySelector('.battery-scheme-mini');
        if (first) {
          const key = first.getAttribute('data-scheme') || 'A';
          const capacity = parseFloat(first.getAttribute('data-capacity') || '5');
          applyPlan(key, capacity);
        }
        // 渲染图标
        try { if (window.lucide && lucide.createIcons) lucide.createIcons(); } catch(e){}
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
  <!-- Utilities: export share cards as image -->
  <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
  <script>
    (function(){
      function bindExportButtons(){
        const buttons = document.querySelectorAll('.btn-export[data-target]');
        buttons.forEach(btn => {
          if (btn.__bound) return; btn.__bound = true;
          btn.addEventListener('click', async () => {
            const sel = btn.getAttribute('data-target');
            const node = document.querySelector(sel);
            if (!node) return;
            const old = btn.innerHTML; btn.disabled = true; btn.innerHTML = '<span>Generating...</span>';
            try {
              const canvas = await html2canvas(node, { backgroundColor: '#ffffff', useCORS: true, scale: 2 });
              const a = document.createElement('a');
              const ts = new Date().toISOString().slice(0,19).replace(/[:T]/g,'-');
              a.href = canvas.toDataURL('image/png');
              a.download = `solar-summary-${ts}.png`;
              document.body.appendChild(a); a.click(); a.remove();
            } catch(err){
              console.error(err); alert('Failed to generate image. Please try again.');
            } finally {
              btn.disabled = false; btn.innerHTML = old;
            }
          });
        });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => { try{ bindExportButtons(); if (window.lucide && lucide.createIcons) lucide.createIcons(); }catch(e){} });
      } else { try{ bindExportButtons(); if (window.lucide && lucide.createIcons) lucide.createIcons(); }catch(e){} }
    })();
  </script>
  <!-- WhatsApp share helper for Shareable summary -->
  <script>
    (function(){
      function getText(el){ return (el && el.textContent ? el.textContent : '').trim(); }
      function buildShareText(suffix){
        const addr = getText(document.getElementById('shareAddr' + suffix));
        const plan = getText(document.getElementById('sharePlan' + suffix));
        const size = getText(document.getElementById('shareSize' + suffix));
        const budget = getText(document.getElementById('shareBudget' + suffix));
        const roi = getText(document.getElementById('shareROI' + suffix));
        const selfUse = getText(document.getElementById('shareSelfUse' + suffix));
        const date = getText(document.getElementById('shareDate' + suffix));
        const url = window.location.href;
        const lines = [
          'Solar Estimation — Shareable Summary',
          addr && ('Address: ' + addr),
          plan && ('Plan: ' + plan),
          size && ('System size: ' + size),
          budget && ('Budget: ' + budget),
          roi && ('Payback: ' + roi),
          selfUse && ('Self-consumption: ' + selfUse),
          date && ('Date: ' + date),
          url && ('Link: ' + url)
        ].filter(Boolean);
        return encodeURIComponent(lines.join('\n'));
      }

      function initDates(){
        try{
          const d = new Date();
          const localeDate = d.toLocaleDateString();
          const el1 = document.getElementById('shareDate');
          const el2 = document.getElementById('shareDate2');
          if (el1 && !el1.textContent) el1.textContent = localeDate;
          if (el2 && !el2.textContent) el2.textContent = localeDate;
        }catch(e){}
      }

      function bindWA(){
        const btn1 = document.getElementById('waShare1');
        if (btn1 && !btn1.__bound) {
          btn1.__bound = true;
          btn1.addEventListener('click', () => {
            const text = buildShareText('');
            const wa = 'https://wa.me/?text=' + text;
            window.open(wa, '_blank');
          });
        }
        const btn2 = document.getElementById('waShare2');
        if (btn2 && !btn2.__bound) {
          btn2.__bound = true;
          btn2.addEventListener('click', () => {
            const text = buildShareText('2');
            const wa = 'https://wa.me/?text=' + text;
            window.open(wa, '_blank');
          });
        }
        try { if (window.lucide && lucide.createIcons) lucide.createIcons(); } catch(e){}
      }

      function init(){ initDates(); bindWA(); }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
